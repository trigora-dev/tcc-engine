{
  "name": "@tcc-engine/frontend-typescript",
  "version": "26.10.3",
  "license": "BUSL-1.1",
  "type": "module",
  "description": "TypeScript frontend: compile supported programs into TCC artifacts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "test": "tsc --noEmit && node --experimental-strip-types --test src/compile.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "typescript": "^5.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0"
  }
}
