{
  "name": "@tcc-engine/bindings-javascript",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "JavaScript binding for the TCC WASM engine",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build:wasm": "cargo build -p tcc-wasm --target wasm32-unknown-unknown --release",
    "typecheck": "node ../../frontends/typescript/node_modules/typescript/bin/tsc --noEmit",
    "test": "node ../../frontends/typescript/node_modules/typescript/bin/tsc --noEmit && node --experimental-strip-types --test src/index.test.ts"
  }
}
