{
  "name": "@tcc-engine/host-node",
  "version": "26.10.2",
  "private": true,
  "type": "module",
  "description": "Node host with SQLite persistence",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-sqlite --experimental-strip-types --test src/host.test.ts src/restart.test.ts src/conformance.test.ts src/persist.test.ts src/kit.test.ts src/join.test.ts",
    "bench:persist:internal": "node --experimental-sqlite --experimental-strip-types src/persist.bench.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@tcc-engine/bindings-javascript": "workspace:*"
  },
  "devDependencies": {
    "@tcc-engine/frontend-typescript": "workspace:*",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0"
  }
}
